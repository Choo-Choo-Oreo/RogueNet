[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/PauseMenu.gd" id="1_pausemenu"]
[ext_resource type="Script" path="res://scripts/ui/PlayerVoiceList.gd" id="2_playervoicelist"]
[ext_resource type="Theme" path="res://resources/UiTheme.tres" id="3_theme"]
[ext_resource type="Script" path="res://scripts/ui/MenuPanel.gd" id="4_menupanel"]

[node name="PauseMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")
script = ExtResource("1_pausemenu")

[node name="Dim" type="ColorRect" parent="."]
color = Color(0, 0, 0, 0.55)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 15
theme_override_constants/margin_top = 15
theme_override_constants/margin_right = 15
theme_override_constants/margin_bottom = 15

[node name="VBoxContainer" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Title" type="Label" parent="Center/Panel/Margin/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"MenuTitle"
text = "PAUSED"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Center/Panel/Margin/VBoxContainer"]
custom_minimum_size = Vector2(110, 25)
layout_mode = 2
text = "Resume"

[node name="SettingsButton" type="Button" parent="Center/Panel/Margin/VBoxContainer"]
custom_minimum_size = Vector2(110, 25)
layout_mode = 2
text = "Settings"

[node name="EndMissionButton" type="Button" parent="Center/Panel/Margin/VBoxContainer"]
visible = false
custom_minimum_size = Vector2(110, 25)
layout_mode = 2
text = "End Mission"

[node name="MainMenuButton" type="Button" parent="Center/Panel/Margin/VBoxContainer"]
custom_minimum_size = Vector2(110, 25)
layout_mode = 2
text = "Main Menu"

[node name="Voices" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -180.0
offset_top = 8.0
offset_right = -8.0
grow_horizontal = 0

[node name="VBoxContainer" type="VBoxContainer" parent="Voices"]
layout_mode = 2

[node name="Title" type="Label" parent="Voices/VBoxContainer"]
layout_mode = 2
text = "VOICES"
horizontal_alignment = 1

[node name="List" type="VBoxContainer" parent="Voices/VBoxContainer"]
layout_mode = 2
script = ExtResource("2_playervoicelist")
with_me = false

[node name="PanelSettings" type="Panel" parent="."]
visible = false
theme_type_variation = &"MenuPanelSolid"
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 95.0
offset_top = 40.0
offset_right = -95.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("4_menupanel")

[connection signal="pressed" from="Center/Panel/Margin/VBoxContainer/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBoxContainer/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBoxContainer/EndMissionButton" to="." method="_on_end_mission_button_pressed"]
[connection signal="pressed" from="Center/Panel/Margin/VBoxContainer/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
