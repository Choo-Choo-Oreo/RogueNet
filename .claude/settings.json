{
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "allow": [
      "WebSearch",
      "Read",
      "Grep",
      "Glob",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Write(tools/**)",
      "Edit(tools/**)"
    ],
    "deny": [
      "Write(scenes/**)",
      "Edit(scenes/**)",
      "Write(scripts/**)",
      "Edit(scripts/**)",
      "Write(singletons/**)",
      "Edit(singletons/**)",
      "Write(project.godot)",
      "Edit(project.godot)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}