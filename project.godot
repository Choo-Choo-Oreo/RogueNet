; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RogueNET"
run/main_scene="uid://bqee185h6kanu"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/AudioBusLayout.tres"

[autoload]

SteamManager="*uid://dm328e1uneq2h"
ConfigFileHandler="*res://singletons/ConfigFileHandler.gd"
NetworkSync="*uid://c2po3jo234gy8"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RogueNET"

[editor_plugins]

enabled=PackedStringArray("res://addons/godotsteam/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://build/": "gray",
"res://game/": "red",
"res://game/rooms/": "red",
"res://resources/": "red",
"res://scenes/": "blue",
"res://scenes/dev/": "purple",
"res://scripts/": "green",
"res://singletons/": "green"
}

