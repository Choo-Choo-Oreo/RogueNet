; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RogueNET"
run/main_scene="uid://dvy7qdmiyab41"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/AudioBusLayout.tres"

[autoload]

SteamManager="*uid://dm328e1uneq2h"
ConfigFileHandler="*res://singletons/ConfigFileHandler.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="RogueNET"

[editor_plugins]

enabled=PackedStringArray("res://addons/godotsteam/plugin.cfg")

[file_customization]

folder_colors={
"res://Scenes/": "blue",
"res://Scenes/rooms/": "red",
"res://addons/": "gray",
"res://build/": "gray",
"res://game/": "red",
"res://resources/": "red",
"res://scripts/": "green",
"res://singletons/": "green"
}

[input]

attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
